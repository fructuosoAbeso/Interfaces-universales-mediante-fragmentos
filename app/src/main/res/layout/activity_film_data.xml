<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA"
    tools:context=".FilmDataActivity">

    <!-- IMAGEN A LA IZQUIERDA -->
    <ImageView
        android:id="@+id/imgCartel"
        android:layout_width="160dp"
        android:layout_height="240dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mi_foto"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:contentDescription="Cartel película" />

    <!-- DATOS A LA DERECHA -->
    <LinearLayout
        android:id="@+id/layoutDatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/imgCartel"
        app:layout_constraintStart_toEndOf="@id/imgCartel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp">

        <TextView
            android:id="@+id/tvNombrePelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre: Interstellar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvDirector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Director: Christopher Nolan"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvAnyo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Año: 2014"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvGenero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Género: Ciencia ficción"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvFormato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formato: Blu-Ray"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            android:textColor="#424242"/>
    </LinearLayout>

    <!-- BOTÓN IMDB A LA DERECHA, DEBAJO DE LOS DATOS -->
    <Button
        android:id="@+id/btnVerImdb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver en IMDB"
        android:textSize="18sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/layoutDatos"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- BOTÓN VOLVER (IZQUIERDA) -->
    <Button
        android:id="@+id/btnVolverPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:textSize="18sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#03A9F4"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"/>

    <!-- BOTÓN EDITAR (DERECHA) -->
    <Button
        android:id="@+id/btnEditarPelicula"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar"
        android:textSize="18sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
