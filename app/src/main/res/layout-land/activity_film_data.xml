<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FAFAFA">

    <!-- IMAGEN A LA IZQUIERDA -->
    <ImageView
        android:id="@+id/imgCartel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mi_foto"
        android:contentDescription="@string/cartel_pelicula"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintDimensionRatio="3:4"/>

    <!-- DATOS A LA DERECHA -->
    <LinearLayout
        android:id="@+id/layoutDatos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgCartel"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNombrePelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cartel_pelicula"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvDirector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/director"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvAnyo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/anyo"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvGenero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/genero"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#424242"/>

        <TextView
            android:id="@+id/tvFormato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formato"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textColor="#424242"/>

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <Button
                android:id="@+id/btnVolverPrincipal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/volver"
                android:backgroundTint="#607D8B"
                android:textColor="#FFFFFF"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnEditarPelicula"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/editar"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnVerImdb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ver_imdb"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
